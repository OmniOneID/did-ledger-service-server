<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet id="create-table_admin_password_reset_token" author="yklee0911">
        <createTable tableName="admin_password_reset_token">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="login_id" type="varchar(50)">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="token" type="varchar(200)">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="token_type" type="varchar(20)" defaultValue="PASSWORD_RESET">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="delivery_method" type="varchar(20)" defaultValue="EMAIL">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="expired_at" type="timestamp" defaultValue="NOW()">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="used" type="boolean" defaultValue="false">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="attempt_count" type="smallint" defaultValue="0">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="true" unique="false"/>
            </column>
            <column name="admin_id" type="bigint" >
                <constraints nullable="false" unique="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
